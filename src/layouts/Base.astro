---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const og = new URL(`${base}img/og.jpg`, Astro.site).href;
// The game's PAGAN fonts, traced to outlines (tools/build_fonts.py); headings use the real glyph sheet (PaganText).
const fontFace = ["gallows_font:Gallows", "gallows_body:Gallows Body"]
  .map((f) => f.split(":"))
  .map(([file, fam]) => `@font-face{font-family:"${fam}";src:url(${base}fonts/${file}.woff2) format("woff2");font-display:swap;}`)
  .join("");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#120d0a" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={`${base}fonts/gallows_body.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/gallows_font.png`} as="image" />
    <style is:inline set:html={fontFace}></style>
  </head>
  <body>
    <slot />
    <script>
      // Reveal-on-scroll.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // Muted loops (video[data-lazy], sources in data-src): load when near the viewport, play only while visible.
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const vio = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              if (v.dataset.lazy !== undefined) {
                v.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach((s) => (s.src = s.dataset.src!));
                delete v.dataset.lazy;
                v.load();
              }
              if (!reduced) v.play().catch(() => {});
            } else v.pause();
          }
        },
        { rootMargin: "300px 0px" },
      );
      document.querySelectorAll<HTMLVideoElement>("video[data-lazy]").forEach((v) => vio.observe(v));
    </script>
  </body>
</html>
