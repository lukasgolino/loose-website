---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const og = new URL(`${base}img/og.jpg`, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The game's PAGAN fonts, traced to outlines (tools/build_fonts.py); headings use the real glyph sheet (PaganText).
const fontFace = ["gallows_font:Gallows", "gallows_body:Gallows Body"]
  .map((f) => f.split(":"))
  .map(([file, fam]) => `@font-face{font-family:"${fam}";src:url(${base}fonts/${file}.woff2) format("woff2");font-display:swap;}`)
  .join("");
// Structured data (schema.org) for search engines and AI assistants.
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "LOOSE!",
      "url": "https://loosegame.com/"
    },
    {
      "@type": "VideoGame",
      "name": "LOOSE!",
      "url": "https://loosegame.com/",
      "description": "A comedic medieval siege game where you are the arrow. Fly yourself into the enemy: eye shots, kill cams, ragdolls, powder kegs and chain reactions.",
      "genre": [
        "Action",
        "Comedy",
        "Physics"
      ],
      "gamePlatform": "PC",
      "applicationCategory": "Game",
      "image": "https://loosegame.com/img/og.jpg",
      "author": {
        "@id": "https://lukasgolino.com/#me"
      },
      "creator": {
        "@id": "https://lukasgolino.com/#me"
      },
      "operatingSystem": "Windows",
      "playMode": "SinglePlayer",
      "keywords": "siege game, arrow game, physics game, ragdoll, medieval, indie game, Godot"
    },
    {
      "@type": "Person",
      "@id": "https://lukasgolino.com/#me",
      "name": "Lukas Golino",
      "url": "https://lukasgolino.com/",
      "sameAs": [
        "https://github.com/lukasgolino"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#120d0a" />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={`${base}fonts/gallows_body.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/gallows_font.webp`} as="image" />
    <link rel="preload" href={`${base}fonts/gallows_title.webp`} as="image" />
    <style is:inline set:html={fontFace}></style>
    {<script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <slot />
    <script>
      // Reveal-on-scroll.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // Muted loops (video[data-lazy], sources in data-src): load when near the viewport, play only while visible.
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const vio = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              if (v.dataset.lazy !== undefined) {
                v.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach((s) => (s.src = s.dataset.src!));
                delete v.dataset.lazy;
                v.load();
              }
              if (!reduced) v.play().catch(() => {});
            } else v.pause();
          }
        },
        { rootMargin: "300px 0px" },
      );
      document.querySelectorAll<HTMLVideoElement>("video[data-lazy]").forEach((v) => vio.observe(v));
    </script>
    {import.meta.env.PROD && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6bb6188fc01947b583ff262c498d1589"}'></script>
    )}
    <!-- Umami: cookieless too; adds per-visit page journeys. One Umami website for all our sites (filter by Host). -->
    {import.meta.env.PROD && (
      <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="6c3ba9da-9af9-49a9-a575-90c9cace445c"></script>
    )}
  </body>
</html>
